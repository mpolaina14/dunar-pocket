# Copia este archivo a .env.local y rellena los valores desde el panel de Neon
# (rama "development", botón Connect). Nunca subas .env.local al repositorio.

# Cadena agrupada (el host lleva "-pooler"). La usa la aplicación.
DATABASE_URL=

# Cadena directa (sin "-pooler"). La usan las migraciones (drizzle-kit).
DATABASE_URL_UNPOOLED=

# Secreto con el que Better Auth firma las sesiones. Genéralo en local con:
#   openssl rand -base64 32
# Cada entorno (local, Preview, Production) usa uno distinto. Nunca lo subas al repositorio.
BETTER_AUTH_SECRET=

# URL base de la aplicación. En local: http://localhost:3000
BETTER_AUTH_URL=
